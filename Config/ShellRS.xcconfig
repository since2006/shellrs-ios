// The app's identity and the oldest iOS it runs on.
//
// PRODUCT_BUNDLE_IDENTIFIER must never change once the app is out: the
// keychain keeps the passwords under it.
PRODUCT_BUNDLE_IDENTIFIER = com.shellrs.ios
IPHONEOS_DEPLOYMENT_TARGET = 17.0
// The version on the App Store; a release tag v<MARKETING_VERSION> uploads
// it (.github/workflows/release.yml), which sets the build number itself.
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 1

// The ShellRS logo, made full-bleed from Design/AppIcon.svg.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// The non-consumable that removes the ads (App Store Connect). Empty: no
// purchase offered.
SHELLRS_REMOVE_ADS_PRODUCT_ID = com.shellrs.ios.lifetime

// AdMob (docs/ADS.md): Google's sample app and test banner and native ad
// units, in every configuration. Whatever is built from the repository shows
// test ads only and never counts against an AdMob account. The App Store
// build gets the real IDs from the release workflow (the GitHub secrets
// ADMOB_APP_ID, ADMOB_BANNER_AD_UNIT_ID and ADMOB_NATIVE_AD_UNIT_ID); a
// Release build on a Mac, from Local.xcconfig, as
// `SHELLRS_ADMOB_APP_ID[config=Release] = …`. A fork that wants no ads sets
// both ad units to nothing in Local.xcconfig: the ads SDK then never starts.
SHELLRS_ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
SHELLRS_BANNER_AD_UNIT_ID = ca-app-pub-3940256099942544/2934735716
SHELLRS_NATIVE_AD_UNIT_ID = ca-app-pub-3940256099942544/3986624511

// DEVELOPMENT_TEAM = <your team id>, to run on an iPhone; not committed.
#include? "Local.xcconfig"
