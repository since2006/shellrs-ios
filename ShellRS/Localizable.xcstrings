      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy couldn’t connect to %@: connection failed (HTTP 502)"
          }
        }
      }
    },
    "代理服务器无法连接到 %@：连接被拒绝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy couldn’t connect to %@: connection refused"
          }
        }
      }
    },
